{
  "name": "havearn-server",
  "version": "1.0.0",
  "description": "HavEarn API + VPS relay server (Express + MongoDB + ws)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
