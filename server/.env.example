PORT=4000
RELAY_PORT=8080
SOCKS_PORT=1080
HTTP_PROXY_PORT=3128
MONGODB_URI=mongodb://127.0.0.1:27017/havearn
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
ADMIN_EMAILS=admin@example.com

# Earnings rates
BANDWIDTH_RATE_PER_GB=10
AD_REWARD_CENTS=5
AD_DAILY_CAP=100
TASK_BASE_REWARD_CENTS=50
REFERRAL_REWARD_CENTS=250
MIN_WITHDRAWAL_CENTS=500

# Public URLs advertised to clients
API_BASE_URL=http://192.168.1.100:4000
RELAY_WS_URL=ws://192.168.1.100:8080

# Buyer-side proxy credentials (SOCKS5 userpass / HTTP Basic)
PROXY_USERNAME=havearn
PROXY_PASSWORD=change-me-now

# Relay abuse limits
MAX_STREAMS_PER_NODE=20
MAX_RELAY_CONNECTIONS=500
